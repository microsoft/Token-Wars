# Token Wars configuration. `terraform apply` (infra/) writes the real ROOT/.env for you.
# Real environment variables override values in .env.
TOKENWARS_TEAM=team-name
AZURE_AI_API_KEY=
# empty if APIM is not deployed
APIM_SUBSCRIPTION_KEY=
# any value; only used if the self-hosted model is deployed
SELFHOSTED_API_KEY=ollama
# key of the US Fireworks on Foundry resource; empty unless deploy_fireworks = true (Challenge 2.4)
FIREWORKS_AI_API_KEY=
# e.g. https://tokenwars-leaderboard.<env>.<region>.azurecontainerapps.io (optional, from your coach)
TOKENWARS_LEADERBOARD_URL=
# optional shared submit key (from your coach)
TOKENWARS_LEADERBOARD_KEY=
# 1 = offline mock mode (no Azure calls)
TOKENWARS_MOCK=0
