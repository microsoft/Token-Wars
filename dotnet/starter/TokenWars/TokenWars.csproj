<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Runs on .NET 8 or any newer installed runtime (9, 10, ...) -->
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TokenWars</RootNamespace>
    <AssemblyName>TokenWars</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- No PackageReferences on purpose: HttpClient + System.Text.Json only. -->
  <!-- strategy.json is read from the current directory (this folder), not copied to the output. -->

</Project>
