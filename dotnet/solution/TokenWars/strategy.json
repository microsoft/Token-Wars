{
  "compact_prompt": true,
  "prompt_cache_friendly": true,
  "retrieval": "keyword",
  "top_k": 3,
  "order_lookup": true,
  "max_output_tokens": 350,
  "exact_cache": true,
  "semantic_cache": true,
  "semantic_cache_threshold": 0.92,
  "default_model": "balanced",
  "routing": "classifier",
  "escalation": true,
  "use_gateway": true,
  "retry_on_throttle": true,
  "concurrency": 8
}
